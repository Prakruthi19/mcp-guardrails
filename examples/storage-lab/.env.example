# GitHub personal access token used to call GitHub Models (free tier).
# No special scopes are required for GitHub Models access.
# https://github.com/settings/tokens -> generate a token -> paste below.
GITHUB_TOKEN=

# Optional overrides -- defaults target GitHub Models' OpenAI-compatible
# endpoint and the free GPT-4o-mini model.
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini
